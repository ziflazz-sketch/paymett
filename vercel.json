{
  "version": 2,
  "functions": {
    "src/app.js": {
      "includeFiles": "public/**"
    },
    "api/**/*.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    }
  ]
}
