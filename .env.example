# ==============================================================================
# RAFA PAYMENT (ZIFLAZZ) — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Reverse Proxy / Cloudflare Settings
# Set to '1' if behind single reverse proxy (e.g. Nginx or Cloudflare WAF)
# Set to 'true' or integer hop count
TRUST_PROXY=1

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://bayar.ziflazz.com,https://ziflazz.com

# Financial Security & HMAC Signature Keys
# Minimum 32-character high-entropy secret string
PAYMENT_GATEWAY_WEBHOOK_SECRET=c8f5d7e1a3b904561234789abcdef0123456789abcdef0123456789abcdef01
QRIS_MERCHANT_ID=ZIFLAZZ_STORE
QRIS_NMID=ID1020030040050

# Webhook IP Whitelisting (Comma-separated exact IPs or CIDR blocks)
# Only authorized payment gateway servers can invoke /api/payments/webhook
# In production, replace with official IP blocks from your acquirer/gateway (e.g., Midtrans, Xendit, etc.)
GATEWAY_WHITELISTED_IPS=103.255.240.1,103.255.240.2,127.0.0.1,::1

# Rate Limiting Configuration
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=900000       # 15 minutes
RATE_LIMIT_QR_CREATE_MAX=10
RATE_LIMIT_QR_CREATE_WINDOW_MS=300000    # 5 minutes
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000       # 1 minute

# Antivirus & File Upload (ClamAV)
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=5000                      # 5 seconds scan timeout
PROOF_UPLOAD_DIR=./uploads/proofs
